# Copy this file to ~/.zshrc.local and fill in real values.
# ~/.zshrc.local is sourced at the end of ~/.zshrc and is gitignored.
# Put credentials, tokens, and any machine-specific overrides here.

# --- HashiCorp Vault (behind Cloudflare Access) -------------------------------
# export VAULT_HEADERS='{"CF-Access-Client-Id":"REPLACE_ME","CF-Access-Client-Secret":"REPLACE_ME"}'

# --- Argo CD ------------------------------------------------------------------
# export ARGOCD_TOKEN="REPLACE_ME"

# --- Cloudflare Access --------------------------------------------------------
# export CF_ACCESS_CLIENT_ID="REPLACE_ME"
# export CF_ACCESS_CLIENT_SECRET="REPLACE_ME"
